{
  "version": "0.2.0",
  "configurations": [{
    "name": "Run Laravel Blade Pro",
    "type": "extensionHost",
    "request": "launch",
    "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/sample-workspace"],
    "outFiles": ["${workspaceFolder}/dist/**/*.js"],
    "preLaunchTask": "npm: build"
  }]
}
